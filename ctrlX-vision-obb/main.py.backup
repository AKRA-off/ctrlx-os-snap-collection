@app.route('/api/detection_data', methods=['GET'])
def get_detection_data():
    """API endpoint to get current detection data"""
    global output_length
    global bool_flask
    global time_toweb

    weights = calculate_weights_for_lengths(output_length)
    avg_length, count_per_kg = calculate_statistics(output_length, weights)

    return {
        'is_processing': bool_flask[0] == 1,
        'time_toweb': time_toweb[0],
        'shrimp_data': [[length, weight] for length, weight in zip(output_length, weights)],
        'avg_length': avg_length,
        'count_per_kg': count_per_kg,
        'timestamp': time()
    }

