                hmi_iou_thres[0] = cfg["iou_thres"][psstr]
                webcam_width[0] = cfg.get("webcam_width", {}).get(psstr, 1280)
                webcam_height[0] = cfg.get("webcam_height", {}).get(psstr, 720)
                pixel_scale = cfg["pixel_scale"]
