def hailo_inf(camid):
    """
    Run HAILO accelerator inference using instance_segmentation module

    Note: This function uses the run_inference_pipeline from instance_segmentation.py
    The model file should be a .hef file (HAILO model format)

    To fully utilize HAILO measurements, you may need to modify instance_segmentation.py
    to return the detected measurements instead of just saving the output image.
    """
    global bool_flask
    global MEDIA_FOLDER
    global model_name
    global time_start
    global time_toweb
    global output_length
    global output_qty
    global pixel_scale

    output_length = []
    output_qty = 0

    # Model name should be .hef file for HAILO
    model_path = MEDIA_FOLDER + model_name[camid]
    input_image_path = MEDIA_FOLDER + "pre" + str(camid) + ".jpg"
    output_dir = MEDIA_FOLDER + "hailo_output"

    try:
        # Import the HAILO inference pipeline
        

        # Create output directory if it doesn't exist
        #os.makedirs(output_dir, exist_ok=True)

        # Load labels from data yaml file (same as in utils.py class_init)
        data_yaml_path = general_path + 'data' + str(camid) + '.yaml'
        labels_list = []

        try:
            with open(data_yaml_path, encoding="utf8") as f:
                yaml_data = yaml.safe_load(f)

            for k in yaml_data['names'].values():
                labels_list.append(k)

            print(f"Loaded {len(labels_list)} labels from {data_yaml_path}", flush=True)
        except Exception as e:
            print(f"Warning: Could not load labels from {data_yaml_path}: {e}", flush=True)
            labels_list = ["object"]  # Fallback to generic label

        # Create a temporary labels file for HAILO pipeline
        temp_labels_file = MEDIA_FOLDER + f"temp_labels_{camid}.txt"
        with open(temp_labels_file, 'w') as f:
            for label in labels_list:
                f.write(f"{label}\n")

        # Determine architecture from model name or use default
        # You may want to add an architecture field to config.yaml
        arch = "v8"  # Default to YOLOv8
        if "yolov5" in model_name[camid].lower() or "v5" in model_name[camid].lower():
            arch = "v5"
        elif "fastsam" in model_name[camid].lower() or "fast" in model_name[camid].lower():
            arch = "fast"

        # Run HAILO inference pipeline
        print(f"Running HAILO inference with model: {model_path}", flush=True)
        run_inference_pipeline(
            net=model_path,
            input_path=input_image_path,
            arch=arch,
            batch_size=1,
            labels_file=temp_labels_file,
            output_dir=output_dir,
            save_stream_output=True,
            resolution="sd",
            enable_tracking=False,
            show_fps=False
        )

        # Clean up temp labels file
        try:
            os.remove(temp_labels_file)
        except:
            pass

        # Find the output image and copy it to the expected location
        output_image_path = MEDIA_FOLDER + "inf" + str(camid) + ".jpg"

        # Look for the output file in the hailo_output directory
        output_files = []
        for ext in ['*.jpg', '*.png']:
            output_files.extend(glob.glob(os.path.join(output_dir, ext)))

        if output_files:
            # Get the most recent output file
            latest_output = max(output_files, key=os.path.getctime)
            shutil.copy(latest_output, output_image_path)
            print(f"HAILO output saved to: {output_image_path}", flush=True)
        else:
            print("Warning: No HAILO output image found", flush=True)
            # Copy the input image as fallback
            shutil.copy(input_image_path, output_image_path)

        # TODO: Extract length measurements from HAILO output
        # The instance_segmentation.py module needs to be modified to return
        # the measurement data (output_length, output_qty) instead of just
        # saving the visualization.
        #
        # For now, measurements will be empty when using HAILO mode.
        # To implement this:
        # 1. Modify instance_segmentation.py to return detection results
        # 2. Extract axis_lengths data from the results
        # 3. Calculate measurements using pixel_scale similar to standard ONNX path

        time_end = time()
        time_toweb[camid] = round(time_end - time_start, 3)
        bool_flask[camid] = 0

    except Exception as e:
        print(f"HAILO inference error: {e}", flush=True)
        import traceback
        traceback.print_exc()
        bool_flask[camid] = 0


def yolo_inf(camid):

    global bool_flask
    global MEDIA_FOLDER
    global model_name
    global hmi_conf_thres
    global hmi_iou_thres
    global time_start
    global time_toweb
    global output_length
    global output_qty
    global pixel_scale
    global use_hailo

    # Check if HAILO mode is enabled
    if use_hailo[camid]:
        hailo_inf(camid)
        return

    #/var/snap/Srexroth-solutions/common/solutions/activeConfiguration/jupyterlab/Vision/
    output_length = []
    output_qty = 0

    yoloseg = YOLOSeg(MEDIA_FOLDER + model_name[camid], conf_thres=hmi_conf_thres[camid], iou_thres=hmi_iou_thres[camid])
    img = cv2.imread(MEDIA_FOLDER + "pre"+ str(camid) + ".jpg")

    # Detect Objects
    boxes, scores, class_ids, masks = yoloseg(img)

    ###cr
    # Retrieve polygons and rotated bounding boxes for each instance
    polygons_per_instance = yoloseg.get_mask_polygons(min_area=20, approx_frac=0.01)
    rotated_boxes = yoloseg.get_mask_bounding_boxes(rotated=True)
    axis_lengths = yoloseg.get_mask_axis_length(use_all_mask_pixels=False)

    # Example: print first instance details
    if len(polygons_per_instance) > 0:
        print("First instance polygons:")
        for poly in polygons_per_instance[0]:
            print(poly.tolist())
    if len(rotated_boxes) > 0 and rotated_boxes[0] is not None:
        print("First instance rotated box (4 points):")
        print(np.array(rotated_boxes[0]).tolist())

    # Print all instances
    for i, info in enumerate(axis_lengths):
        print(f"Instance {i}:")
        if i < len(polygons_per_instance):
            for poly in polygons_per_instance[i]:
                print("  polygon:", poly.tolist())
        if i < len(rotated_boxes) and rotated_boxes[i] is not None:
            print("  rotated_box:", np.array(rotated_boxes[i]).tolist())
        if info is not None:
            # Get length in pixels
            length_pixels = info.get('endpoint_length', info['length'])
            # Convert to real-world units (mm) using pixel scale
            length_mm = length_pixels * pixel_scale

            print("  principal-axis length (pixels):", round(info['length'], 2))
            print("  endpoint length (pixels):", round(length_pixels, 2))
            print("  endpoint length (mm):", round(length_mm, 2))
            print("  center:", tuple(round(v, 2) for v in info['center']))
            print("  axis dir:", tuple(round(v, 4) for v in info['axis']))
            print("  endpoints:", np.round(info['endpoints'], 2).tolist())

            # Store the scaled measurement in mm
            output_length.append(round(length_mm, 2))
            output_qty = i+1
    ###/cr

    # Draw detections
    combined_img = yoloseg.draw_masks(img)
    # Also draw principal axes for each instance
    combined_img = yoloseg.draw_axes(combined_img, color=(255, 255, 0), thickness=2, use_all_mask_pixels=False)

    cv2.imwrite(MEDIA_FOLDER +"inf" + str(camid) + ".jpg", combined_img)

    time_end = time()
    time_toweb[camid] = round(time_end - time_start, 3)
    
    bool_flask[camid] = 0

    

def main():

    global variable
    global bool_flask
    global MEDIA_FOLDER
    global model_name
    global model_name_temp
    global initialize_var
