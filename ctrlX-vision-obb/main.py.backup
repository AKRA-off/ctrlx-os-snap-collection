# Weight calculation functions
def load_weight_data():
    """Load weight data from CSV file and return sorted arrays"""
    
    csv_path = general_path + 'weight.csv'
    lengths = []
    weights = []

    try:
        with open(csv_path, 'r') as f:
            reader = csv.DictReader(f)
            for row in reader:
                try:
                    length = float(row['Length(mm)'])
                    weight = float(row['Weight(g)'])
                    lengths.append(length)
                    weights.append(weight)
                except (ValueError, KeyError):
                    continue

        # Sort by length
        if lengths:
            sorted_data = sorted(zip(lengths, weights))
            lengths, weights = zip(*sorted_data)
            return list(lengths), list(weights)
    except FileNotFoundError:
        logger.warning(f"Weight CSV file not found at {csv_path}")

    return [], []

def interpolate_weight(length_mm, ref_lengths, ref_weights):
    """Calculate weight for a given length using linear interpolation"""
    if not ref_lengths or not ref_weights:
        return 0.0

    # If length is below minimum, use minimum weight
    if length_mm <= ref_lengths[0]:
        return ref_weights[0]

    # If length is above maximum, use maximum weight
    if length_mm >= ref_lengths[-1]:
        return ref_weights[-1]

    # Find the two points to interpolate between
    for i in range(len(ref_lengths) - 1):
        if ref_lengths[i] <= length_mm <= ref_lengths[i + 1]:
            # Linear interpolation
            x0, x1 = ref_lengths[i], ref_lengths[i + 1]
            y0, y1 = ref_weights[i], ref_weights[i + 1]
            weight = y0 + (y1 - y0) * (length_mm - x0) / (x1 - x0)
            return round(weight, 2)

    return 0.0

def calculate_weights_for_lengths(lengths):
    """Calculate weights for all detected lengths"""
    ref_lengths, ref_weights = load_weight_data()
    weights = []

    for length in lengths:
        weight = interpolate_weight(length, ref_lengths, ref_weights)
        weights.append(weight)

    return weights

def calculate_statistics(lengths, weights):
    """Calculate average length and count per 1kg"""
    if not lengths or not weights:
        return 0.0, 0

    avg_length = sum(lengths) / len(lengths)
    avg_weight = sum(weights) / len(weights)

    # Calculate how many shrimps of average size in 1kg (1000g)
    count_per_kg = 0
    if avg_weight > 0:
        count_per_kg = int(1000.0 / avg_weight)

    return round(avg_length, 2), count_per_kg


